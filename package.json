{
  "name": "med-advisor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:pages": "cross-env BASE_PATH=MED-advisor npm run build",
    "preview:pages": "cross-env BASE_PATH=MED-advisor vite preview --port 4173",
    "verify:pages": "npm run build:pages && npm run preview:pages",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "fixtures:import": "node scripts/fixtures-import.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "4.3.3",
    "@vitest/coverage-v8": "2.1.8",
    "cross-env": "7.0.3",
    "eslint": "8.57.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "description": "機械設計小幫手 — 螺絲孔設計建議工具"
}
